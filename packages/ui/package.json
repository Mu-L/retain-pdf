{
  "name": "@retainpdf/ui",
  "version": "0.1.0",
  "private": false,
  "description": "RetainPDF shared UI primitives — cn, button, dialog, etc. (extracted from apps/web)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lib/utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js"
    },
    "./components/ui/button": {
      "types": "./dist/components/ui/button.d.ts",
      "import": "./dist/components/ui/button.js"
    },
    "./styles.css": "./dist/ui.css"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:css",
    "build:css": "node ./scripts/build-css.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsc --watch -p tsconfig.json"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}

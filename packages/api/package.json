{
  "name": "@retainpdf/api",
  "version": "0.1.0",
  "private": false,
  "description": "RetainPDF typed API clients — library-books, jobs, status (wraps @retainpdf/schemas)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./library-books": {
      "types": "./dist/library-books.d.ts",
      "import": "./dist/library-books.js"
    },
    "./jobs": {
      "types": "./dist/jobs.d.ts",
      "import": "./dist/jobs.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsc --watch -p tsconfig.json"
  },
  "peerDependencies": {
    "zod": "^3.22.0"
  },
  "peerDependenciesMeta": {
    "zod": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}

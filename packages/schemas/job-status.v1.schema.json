{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retainpdf/contracts/job-status/v1",
  "title": "任务状态与阶段进度契约（Job Status / Stage Progress Bundle）",
  "description": "Rust ↔ TS 任务状态单一真值（含 stage_snapshot / progress / cover_url 等重复高发区）。生产者：services/api crates/retain-core models/view/job_types.rs（JobDetailView / JobListView / JobStageSnapshotView / JobProgressView）与 models/view/common.rs（JobStagesView 等）；消费者：apps/web src/js/job/types.ts & src/js/job-status/types.ts（normalize / public-stage-engine / progress adapters）与 apps/web-react src/features/library/api/library-api-types.ts & src/features/status/types.ts。所有响应为 {code, message, data} 信封，本契约描述 data。改契约先改本文件，再让两端测试变绿；后续由本文件生成 TS 类型替换手写 duplication。",
  "base_path": "/api/v1/jobs",
  "endpoints": [
    {
      "method": "GET",
      "path": "/api/v1/jobs",
      "query": "ListJobsQuery",
      "output": "JobListView",
      "rust_view": "JobListView",
      "ts_consumer": "apps/web/src/js/job/types.ts :: JobLike / apps/web-react type JobListView"
    },
    {
      "method": "GET",
      "path": "/api/v1/jobs/:job_id",
      "output": "JobDetailView",
      "rust_view": "JobDetailView",
      "ts_consumer": "apps/web/src/js/job/types.ts :: JobPayload"
    },
    {
      "method": "GET",
      "path": "/api/v1/jobs/:job_id/events",
      "query": "ListJobEventsQuery",
      "output": "JobEventListView"
    },
    {
      "method": "GET",
      "path": "/api/v1/ocr/jobs/:job_id",
      "output": "JobDetailView",
      "note": "WorkflowKind::Ocr 走 /api/v1/ocr/jobs 前缀，view 形状与 book 一致"
    }
  ],
  "definitions": {
    "JobStatusKind": {
      "type": "string",
      "enum": ["queued", "running", "succeeded", "failed", "canceled"],
      "description": "crate::models::common::JobStatusKind"
    },
    "WorkflowKind": {
      "type": "string",
      "enum": ["book", "ocr", "translate", "render"]
    },
    "JobProgressView": {
      "type": "object",
      "description": "common.rs :: JobProgressView。前端 progress_unit / progress_current / progress_total 均由此归一。",
      "required": [],
      "properties": {
        "current": { "type": ["integer", "null"], "description": "JobProgress.current，null=未知" },
        "total": { "type": ["integer", "null"] },
        "percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "unit": { "type": ["string", "null"], "description": "page|batch|step|percent，skip_serializing_if None" }
      }
    },
    "JobStageSnapshotView": {
      "type": "object",
      "description": "job_types.rs :: JobStageSnapshotView。前端 adaptJobStageSnapshot / buildStageSnapshot 消费全部字段；lane=main|background。",
      "required": ["progress"],
      "properties": {
        "display_stage": { "type": ["string", "null"] },
        "stage": { "type": ["string", "null"] },
        "substage": { "type": ["string", "null"] },
        "lane": { "type": ["string", "null"] },
        "stage_detail": { "type": ["string", "null"] },
        "progress": { "$ref": "#/definitions/JobProgressView" }
      }
    },
    "JobStageStateView": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "failed", "skipped"]
    },
    "JobStageRuntimeView": {
      "type": "object",
      "required": ["state", "progress"],
      "properties": {
        "state": { "$ref": "#/definitions/JobStageStateView" },
        "progress": { "$ref": "#/definitions/JobProgressView" }
      }
    },
    "JobStagesView": {
      "type": "object",
      "required": ["ocr", "translation", "render"],
      "properties": {
        "ocr": { "$ref": "#/definitions/JobStageRuntimeView" },
        "translation": { "$ref": "#/definitions/JobStageRuntimeView" },
        "render": { "$ref": "#/definitions/JobStageRuntimeView" }
      }
    },
    "JobTimestampsView": {
      "type": "object",
      "required": ["created_at", "updated_at"],
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "started_at": { "type": ["string", "null"] },
        "finished_at": { "type": ["string", "null"] },
        "duration_seconds": { "type": ["number", "null"] }
      }
    },
    "JobLinksView": {
      "type": "object",
      "required": ["self_path", "self_url", "artifacts_path", "artifacts_url", "artifacts_manifest_path", "artifacts_manifest_url", "events_path", "events_url", "cancel_path", "cancel_url"],
      "properties": {
        "self_path": { "type": "string" },
        "self_url": { "type": "string", "format": "uri" },
        "artifacts_path": { "type": "string" },
        "artifacts_url": { "type": "string" },
        "artifacts_manifest_path": { "type": "string" },
        "artifacts_manifest_url": { "type": "string" },
        "events_path": { "type": "string" },
        "events_url": { "type": "string" },
        "cancel_path": { "type": "string" },
        "cancel_url": { "type": "string" }
      }
    },
    "ActionLinkView": {
      "type": "object",
      "required": ["enabled", "method", "path", "url"],
      "properties": {
        "enabled": { "type": "boolean" },
        "method": { "type": "string" },
        "path": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "JobActionsView": {
      "type": "object",
      "required": ["open_job", "open_artifacts", "cancel", "rerun", "download_pdf", "open_markdown", "open_markdown_raw", "download_bundle"],
      "properties": {
        "open_job": { "$ref": "#/definitions/ActionLinkView" },
        "open_artifacts": { "$ref": "#/definitions/ActionLinkView" },
        "cancel": { "$ref": "#/definitions/ActionLinkView" },
        "rerun": { "$ref": "#/definitions/ActionLinkView" },
        "download_pdf": { "$ref": "#/definitions/ActionLinkView" },
        "open_markdown": { "$ref": "#/definitions/ActionLinkView" },
        "open_markdown_raw": { "$ref": "#/definitions/ActionLinkView" },
        "download_bundle": { "$ref": "#/definitions/ActionLinkView" }
      }
    },
    "ResourceLinkView": {
      "type": "object",
      "required": ["ready", "path", "url", "method", "content_type"],
      "properties": {
        "ready": { "type": "boolean" },
        "path": { "type": "string" },
        "url": { "type": "string" },
        "method": { "type": "string" },
        "content_type": { "type": "string" },
        "file_name": { "type": ["string", "null"] },
        "size_bytes": { "type": ["integer", "null"] }
      }
    },
    "MarkdownArtifactView": {
      "type": "object",
      "required": ["ready", "json_path", "json_url", "raw_path", "raw_url", "images_base_path", "images_base_url"],
      "properties": {
        "ready": { "type": "boolean" },
        "json_path": { "type": "string" },
        "json_url": { "type": "string" },
        "raw_path": { "type": "string" },
        "raw_url": { "type": "string" },
        "images_base_path": { "type": "string" },
        "images_base_url": { "type": "string" },
        "file_name": { "type": ["string", "null"] },
        "size_bytes": { "type": ["integer", "null"] }
      }
    },
    "ArtifactLinksView": {
      "type": "object",
      "required": ["pdf_ready", "markdown_ready", "bundle_ready", "pdf_url", "markdown_url", "markdown_images_base_url", "bundle_url", "normalized_document_url", "normalization_report_url", "manifest_path", "manifest_url", "actions", "normalized_document", "normalization_report", "pdf", "markdown", "bundle"],
      "properties": {
        "pdf_ready": { "type": "boolean" },
        "markdown_ready": { "type": "boolean" },
        "bundle_ready": { "type": "boolean" },
        "schema_version": { "type": ["string", "null"] },
        "provider_raw_dir": { "type": ["string", "null"] },
        "provider_zip": { "type": ["string", "null"] },
        "provider_summary_json": { "type": ["string", "null"] },
        "pdf_url": { "type": "string" },
        "markdown_url": { "type": "string" },
        "markdown_images_base_url": { "type": "string" },
        "bundle_url": { "type": "string" },
        "normalized_document_url": { "type": "string" },
        "normalization_report_url": { "type": "string" },
        "manifest_path": { "type": "string" },
        "manifest_url": { "type": "string" },
        "actions": { "$ref": "#/definitions/JobActionsView" },
        "normalized_document": { "$ref": "#/definitions/ResourceLinkView" },
        "normalization_report": { "$ref": "#/definitions/ResourceLinkView" },
        "pdf": { "$ref": "#/definitions/ResourceLinkView" },
        "markdown": { "$ref": "#/definitions/MarkdownArtifactView" },
        "bundle": { "$ref": "#/definitions/ResourceLinkView" }
      }
    },
    "ArtifactDisplayItemView": {
      "type": "object",
      "required": ["key", "label", "ready", "kind"],
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "ready": { "type": "boolean" },
        "kind": { "type": "string" },
        "file_name": { "type": ["string", "null"] },
        "size_bytes": { "type": ["integer", "null"] },
        "download_url": { "type": ["string", "null"] }
      }
    },
    "BookSummaryView": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string" },
        "authors": { "type": ["string", "null"] },
        "page_count": { "type": ["integer", "null"] },
        "source_language": { "type": ["string", "null"] },
        "target_language": { "type": ["string", "null"] },
        "source_file_name": { "type": ["string", "null"] },
        "cover_url": { "type": ["string", "null"] },
        "thumbnail_url": { "type": ["string", "null"], "description": "前端常用，Rust ListItem 有，BookSummary 扩展补充" },
        "file_size_bytes": { "type": ["integer", "null"] }
      }
    },
    "JobContractsView": {
      "type": "object",
      "required": ["schema_version", "stages"],
      "properties": {
        "schema_version": { "type": "string" },
        "stages": {
          "type": "array",
          "items": { "$ref": "#/definitions/JobStageContractView" }
        }
      }
    },
    "JobStageContractView": {
      "type": "object",
      "required": ["stage", "ready", "artifacts"],
      "properties": {
        "stage": { "type": "string" },
        "ready": { "type": "boolean" },
        "artifacts": { "type": "array", "items": { "$ref": "#/definitions/JobStageContractArtifactView" } }
      }
    },
    "JobStageContractArtifactView": {
      "type": "object",
      "required": ["artifact_key", "required", "ready"],
      "properties": {
        "artifact_key": { "type": "string" },
        "required": { "type": "boolean" },
        "ready": { "type": "boolean" },
        "relative_path": { "type": ["string", "null"] },
        "detail": { "type": ["string", "null"] }
      }
    },
    "OcrJobSummaryView": {
      "type": "object",
      "required": ["job_id", "detail_path", "detail_url"],
      "properties": {
        "job_id": { "type": "string" },
        "status": { "anyOf": [{ "$ref": "#/definitions/JobStatusKind" }, { "type": "null" }] },
        "trace_id": { "type": ["string", "null"] },
        "provider_trace_id": { "type": ["string", "null"] },
        "detail_path": { "type": "string" },
        "detail_url": { "type": "string" }
      }
    },
    "InvocationSummaryView": {
      "type": "object",
      "required": ["stage", "input_protocol", "stage_spec_schema_version"],
      "properties": {
        "stage": { "type": "string" },
        "input_protocol": { "type": "string" },
        "stage_spec_schema_version": { "type": "string" }
      }
    },
    "JobListItemView": {
      "type": "object",
      "description": "job_types.rs :: JobListItemView — 列表卡用；关键字段 job_id / display_name / workflow / status / stage_snapshot / progress(经 stage_snapshot.progress) / cover_url 均在契约内。",
      "required": ["job_id", "display_name", "workflow", "status", "stage_snapshot", "background_snapshots", "stages", "output_pdf_ready", "markdown_ready", "bundle_ready", "created_at", "updated_at", "detail_path", "detail_url"],
      "properties": {
        "job_id": { "type": "string" },
        "display_name": { "type": "string" },
        "workflow": { "$ref": "#/definitions/WorkflowKind" },
        "status": { "$ref": "#/definitions/JobStatusKind" },
        "trace_id": { "type": ["string", "null"] },
        "stage_snapshot": { "anyOf": [{ "$ref": "#/definitions/JobStageSnapshotView" }, { "type": "null" }] },
        "background_snapshots": { "type": "array", "items": { "$ref": "#/definitions/JobStageSnapshotView" } },
        "stages": { "$ref": "#/definitions/JobStagesView" },
        "page_count": { "type": ["integer", "null"] },
        "source_file_name": { "type": ["string", "null"] },
        "cover_url": { "type": ["string", "null"] },
        "thumbnail_url": { "type": ["string", "null"] },
        "output_pdf_ready": { "type": "boolean" },
        "markdown_ready": { "type": "boolean" },
        "bundle_ready": { "type": "boolean" },
        "invocation": { "anyOf": [{ "$ref": "#/definitions/InvocationSummaryView" }, { "type": "null" }] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "detail_path": { "type": "string" },
        "detail_url": { "type": "string" }
      }
    },
    "JobListInvocationSummaryView": {
      "type": "object",
      "required": ["stage_spec_count", "unknown_count"],
      "properties": {
        "stage_spec_count": { "type": "integer" },
        "unknown_count": { "type": "integer" }
      }
    },
    "JobListView": {
      "type": "object",
      "required": ["items", "invocation_summary"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/definitions/JobListItemView" } },
        "invocation_summary": { "$ref": "#/definitions/JobListInvocationSummaryView" }
      }
    },
    "JobDetailView": {
      "type": "object",
      "description": "job_types.rs :: JobDetailView。关键重复字段：job_id, workflow, status, stage_snapshot(含 progress), cover_url(经 book_summary.cover_url) 均上锁。",
      "required": ["job_id", "workflow", "status", "request_payload", "stages", "timestamps", "links", "actions", "artifacts", "artifacts_display", "book_summary", "contracts", "log_tail"],
      "properties": {
        "job_id": { "type": "string" },
        "workflow": { "$ref": "#/definitions/WorkflowKind" },
        "status": { "$ref": "#/definitions/JobStatusKind" },
        "request_payload": { "type": "object" },
        "trace_id": { "type": ["string", "null"] },
        "provider_trace_id": { "type": ["string", "null"] },
        "stage_snapshot": { "anyOf": [{ "$ref": "#/definitions/JobStageSnapshotView" }, { "type": "null" }] },
        "background_snapshots": { "type": "array", "items": { "$ref": "#/definitions/JobStageSnapshotView" } },
        "stages": { "$ref": "#/definitions/JobStagesView" },
        "timestamps": { "$ref": "#/definitions/JobTimestampsView" },
        "links": { "$ref": "#/definitions/JobLinksView" },
        "actions": { "$ref": "#/definitions/JobActionsView" },
        "artifacts": { "$ref": "#/definitions/ArtifactLinksView" },
        "artifacts_display": { "type": "array", "items": { "$ref": "#/definitions/ArtifactDisplayItemView" } },
        "book_summary": { "$ref": "#/definitions/BookSummaryView" },
        "contracts": { "$ref": "#/definitions/JobContractsView" },
        "ocr_job": { "anyOf": [{ "$ref": "#/definitions/OcrJobSummaryView" }, { "type": "null" }] },
        "ocr_provider_diagnostics": { "type": ["object", "null"] },
        "runtime": { "type": ["object", "null"] },
        "failure": { "type": ["object", "null"] },
        "error": { "type": ["string", "null"] },
        "failure_diagnostic": { "type": ["object", "null"] },
        "normalization_summary": { "type": ["object", "null"] },
        "glossary_summary": { "type": ["object", "null"] },
        "invocation": { "anyOf": [{ "$ref": "#/definitions/InvocationSummaryView" }, { "type": "null" }] },
        "log_tail": { "type": "array", "items": { "type": "string" } }
      }
    },
    "JobEventListView": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": { "type": "array", "items": { "type": "object" } }
      }
    },
    "ListJobsQuery": {
      "type": "object",
      "properties": {
        "limit": { "type": "integer" },
        "offset": { "type": "integer" },
        "status": { "$ref": "#/definitions/JobStatusKind" },
        "workflow": { "$ref": "#/definitions/WorkflowKind" },
        "provider": { "type": "string" },
        "q": { "type": "string" },
        "job_ids": { "type": "string" }
      }
    },
    "ListJobEventsQuery": {
      "type": "object",
      "properties": {
        "limit": { "type": "integer" },
        "offset": { "type": "integer" }
      }
    }
  }
}

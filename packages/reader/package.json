{
  "name": "@retainpdf/reader",
  "version": "0.1.0",
  "private": false,
  "description": "RetainPDF reader — standalone react-pdf engine (extracted from apps/web)",
  "type": "module",
  "main": "./dist/retain-reader.js",
  "module": "./dist/retain-reader.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/retain-reader.js"
    },
    "./styles.css": "./dist/retain-reader.css"
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "vite --port 40003"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "react-pdf": "^9.2.1",
    "pdfjs-dist": "^4.8.69",
    "mathjax-full": "^3.2.1"
  },
  "devDependencies": {
    "vite": "^6.3.0",
    "typescript": "^7.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}

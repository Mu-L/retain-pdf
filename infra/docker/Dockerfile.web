FROM node:22-alpine AS frontend-builder

# P0-4 SPA readiness (additive only): FRONTEND_APP selects the frontend to ship.
# Default "web" keeps production on apps/web. Opt-in SPA:
#   docker build --build-arg FRONTEND_APP=web-react -f infra/docker/Dockerfile.web .
# Do NOT change the default until the SPA cutover is explicitly approved.
ARG FRONTEND_APP="web"

ARG RETAIN_PDF_VERSION=""
ENV RETAIN_PDF_VERSION="${RETAIN_PDF_VERSION}"

WORKDIR /app

# Install from the monorepo lock. Running npm ci from apps/web while a workspace
# root package.json exists makes npm resolve /app as the install root, so the
# root lock and every workspace manifest must be present in this cache layer.
COPY package.json package-lock.json ./
COPY apps/desktop/package.json ./apps/desktop/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY apps/web-react/package.json ./apps/web-react/package.json
COPY packages/api/package.json ./packages/api/package.json
COPY packages/domain/package.json ./packages/domain/package.json
COPY packages/reader/package.json ./packages/reader/package.json
COPY packages/schemas/package.json ./packages/schemas/package.json
COPY packages/ui/package.json ./packages/ui/package.json
RUN npm ci --ignore-scripts

COPY packages/reader/ ./packages/reader/
COPY packages/ui/ ./packages/ui/
COPY packages/api/ ./packages/api/
COPY packages/domain/ ./packages/domain/
COPY packages/schemas/ ./packages/schemas/
COPY apps/web/ ./apps/web/
COPY apps/web-react/ ./apps/web-react/
WORKDIR /app/apps/web
RUN npm run build && \
  : > ./runtime-config.local.js

# SPA opt-in build (P0-4, default off). Only runs when FRONTEND_APP=web-react.
# Produces apps/web-react/dist (single index.html + assets/). Default web path above is untouched.
RUN if [ "${FRONTEND_APP}" = "web-react" ]; then \
    npm --prefix /app/apps/web-react run build && \
    : > /app/apps/web-react/dist/runtime-config.local.js; \
  fi

FROM nginx:1.27-alpine

# Redeclare so the nginx stage can read the build arg (default stays on apps/web).
ARG FRONTEND_APP="web"

# Ensures the official nginx envsubst entrypoint always replaces the template
# placeholder, even when server-side API-key injection is intentionally off.
ENV RETAINPDF_PROXY_API_KEY=""

RUN apk add --no-cache bash gettext jq

COPY --from=frontend-builder /app/apps/web/ /usr/share/nginx/html/
# SPA artifact staged alongside (P0-4, default inert): builder only fills
# /app/apps/web-react/dist with a fresh build when FRONTEND_APP=web-react,
# otherwise this is the repo-checked-in dist and is discarded below.
COPY --from=frontend-builder /app/apps/web-react/dist/ /tmp/frontend-spa/
COPY infra/docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY infra/docker/nginx-mjs.types.conf /etc/nginx/conf.d/mjs.types.conf
COPY infra/docker/entrypoint-web.sh /docker-entrypoint.d/99-runtime-config.sh

# SPA selection (default no-op): only when FRONTEND_APP=web-react replace the
# html root with the SPA dist. entrypoint-web.sh then writes runtime-config.js
# (SPA index.html loads ./runtime-config.js; nginx try_files /index.html already covers SPA routes).
RUN if [ "${FRONTEND_APP}" = "web-react" ]; then \
    rm -rf /usr/share/nginx/html && \
    mkdir -p /usr/share/nginx/html && \
    cp -a /tmp/frontend-spa/. /usr/share/nginx/html/; \
  fi; \
  rm -rf /tmp/frontend-spa

RUN rm -rf \
  /usr/share/nginx/html/node_modules \
  /usr/share/nginx/html/.ipynb_checkpoints \
  /usr/share/nginx/html/src/.ipynb_checkpoints && \
  rm -f \
  /usr/share/nginx/html/package.json \
  /usr/share/nginx/html/package-lock.json \
  /usr/share/nginx/html/tailwind.config.js \
  /usr/share/nginx/html/.gitignore

RUN chmod +x /docker-entrypoint.d/99-runtime-config.sh

EXPOSE 80

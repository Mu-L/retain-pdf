FROM node:22-alpine AS frontend-builder

ARG RETAIN_PDF_VERSION=""
ENV RETAIN_PDF_VERSION="${RETAIN_PDF_VERSION}"

WORKDIR /app

# workspace packages needed for @retainpdf/* file: deps (reader/ui/api)
COPY package.json ./
COPY packages/reader/package.json ./packages/reader/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/api/package.json ./packages/api/package.json
COPY apps/web/package.json apps/web/package-lock.json ./apps/web/
COPY packages/reader/ ./packages/reader/
COPY packages/ui/ ./packages/ui/
COPY packages/api/ ./packages/api/
# strip scripts that need local node_modules (prevent npm ci from running package prepare)
RUN rm -rf ./packages/reader/node_modules ./packages/ui/node_modules || true

WORKDIR /app/apps/web
RUN npm ci

COPY apps/desktop/package.json /app/apps/desktop/package.json
COPY apps/web/ ./
RUN npm run build && \
  : > ./runtime-config.local.js

FROM nginx:1.27-alpine

RUN apk add --no-cache bash gettext

COPY --from=frontend-builder /app/apps/web/ /usr/share/nginx/html/
COPY infra/docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY infra/docker/nginx-mjs.types.conf /etc/nginx/conf.d/mjs.types.conf
COPY infra/docker/entrypoint-web.sh /docker-entrypoint.d/99-runtime-config.sh

RUN rm -rf \
  /usr/share/nginx/html/node_modules \
  /usr/share/nginx/html/.ipynb_checkpoints \
  /usr/share/nginx/html/src/.ipynb_checkpoints && \
  rm -f \
  /usr/share/nginx/html/package.json \
  /usr/share/nginx/html/package-lock.json \
  /usr/share/nginx/html/tailwind.config.js \
  /usr/share/nginx/html/.gitignore

RUN chmod +x /docker-entrypoint.d/99-runtime-config.sh

EXPOSE 80

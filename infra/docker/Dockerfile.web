FROM node:22-alpine AS frontend-builder

ARG RETAIN_PDF_VERSION=""
ENV RETAIN_PDF_VERSION="${RETAIN_PDF_VERSION}"

WORKDIR /app

# Install from the monorepo lock. Running npm ci from apps/web while a workspace
# root package.json exists makes npm resolve /app as the install root, so the
# root lock and every workspace manifest must be present in this cache layer.
COPY package.json package-lock.json ./
COPY apps/desktop/package.json ./apps/desktop/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY apps/web-react/package.json ./apps/web-react/package.json
COPY packages/api/package.json ./packages/api/package.json
COPY packages/domain/package.json ./packages/domain/package.json
COPY packages/reader/package.json ./packages/reader/package.json
COPY packages/schemas/package.json ./packages/schemas/package.json
COPY packages/ui/package.json ./packages/ui/package.json
RUN npm ci --ignore-scripts

COPY packages/reader/ ./packages/reader/
COPY packages/ui/ ./packages/ui/
COPY packages/api/ ./packages/api/
COPY packages/domain/ ./packages/domain/
COPY packages/schemas/ ./packages/schemas/
COPY apps/web/ ./apps/web/
WORKDIR /app/apps/web
RUN npm run build && \
  : > ./runtime-config.local.js

FROM nginx:1.27-alpine

# Ensures the official nginx envsubst entrypoint always replaces the template
# placeholder, even when server-side API-key injection is intentionally off.
ENV RETAINPDF_PROXY_API_KEY=""

RUN apk add --no-cache bash gettext jq

COPY --from=frontend-builder /app/apps/web/ /usr/share/nginx/html/
COPY infra/docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY infra/docker/nginx-mjs.types.conf /etc/nginx/conf.d/mjs.types.conf
COPY infra/docker/entrypoint-web.sh /docker-entrypoint.d/99-runtime-config.sh

RUN rm -rf \
  /usr/share/nginx/html/node_modules \
  /usr/share/nginx/html/.ipynb_checkpoints \
  /usr/share/nginx/html/src/.ipynb_checkpoints && \
  rm -f \
  /usr/share/nginx/html/package.json \
  /usr/share/nginx/html/package-lock.json \
  /usr/share/nginx/html/tailwind.config.js \
  /usr/share/nginx/html/.gitignore

RUN chmod +x /docker-entrypoint.d/99-runtime-config.sh

EXPOSE 80
